#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
skill_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
vendor_root="$skill_root/vendor"

if command -v python3 >/dev/null 2>&1; then
  python_cmd=python3
elif command -v python >/dev/null 2>&1; then
  python_cmd=python
else
  echo '{"ok":false,"error":{"type":"configuration_error","message":"Python 3 runtime not found"}}' >&2
  exit 2
fi

PYTHONPATH="$vendor_root${PYTHONPATH:+:$PYTHONPATH}" exec "$python_cmd" -m moedu_agent_cli "$@"
